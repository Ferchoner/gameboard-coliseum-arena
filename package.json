{
  "name": "gameboard",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=26.13.0 <27"
  },
  "scripts": {
    "build": "pnpm -r --workspace-concurrency=1 run build",
    "typecheck": "pnpm -r run typecheck",
    "lint": "eslint .",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "deps:check": "depcruise apps/backend/src apps/backend/test apps/frontend packages/contracts/src packages/game-engine/src --config .dependency-cruiser.cjs",
    "test": "pnpm -r run test",
    "test:e2e": "pnpm --filter @gameboard/e2e run e2e",
    "check": "pnpm format:check && pnpm lint && pnpm build && pnpm deps:check && pnpm typecheck && pnpm test",
    "db:up": "docker compose up -d --wait postgres",
    "db:down": "docker compose down",
    "db:migrate": "pnpm --filter @gameboard/backend run db:migrate",
    "dev": "node scripts/dev.mjs http",
    "dev:https": "node scripts/dev.mjs https",
    "dev:cert": "node scripts/dev-cert.mjs",
    "icons": "node scripts/pwa-icons.mjs"
  },
  "devDependencies": {
    "@eslint/js": "10.0.1",
    "dependency-cruiser": "18.7.2",
    "eslint": "10.15.0",
    "eslint-config-prettier": "10.1.8",
    "eslint-plugin-vue": "10.12.1",
    "globals": "17.14.0",
    "prettier": "3.10.1",
    "typescript": "6.0.3",
    "typescript-eslint": "8.72.2"
  }
}
