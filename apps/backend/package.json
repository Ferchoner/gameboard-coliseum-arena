{
  "name": "@gameboard/backend",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "start": "node --env-file-if-exists=.env dist/main.js",
    "dev": "node scripts/dev.mjs",
    "test": "vitest run",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "node --env-file-if-exists=.env dist/database/migrate.js"
  },
  "dependencies": {
    "@gameboard/contracts": "workspace:*",
    "@gameboard/game-engine": "workspace:*",
    "@nestjs/common": "12.5.0",
    "@nestjs/core": "12.5.0",
    "@nestjs/platform-express": "12.5.0",
    "drizzle-orm": "1.0.0-rc.5",
    "pg": "8.23.1",
    "reflect-metadata": "0.2.2",
    "rxjs": "7.8.2",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@nestjs/testing": "12.5.0",
    "@types/express": "5.0.6",
    "@types/node": "catalog:",
    "@types/pg": "8.23.1",
    "@types/supertest": "7.2.1",
    "ajv": "8.20.0",
    "ajv-formats": "3.0.1",
    "drizzle-kit": "1.0.0-rc.5",
    "supertest": "7.3.2",
    "typescript": "catalog:",
    "vitest": "catalog:",
    "yaml": "2.9.1"
  }
}
