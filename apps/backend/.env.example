# Configuración del backend. Todas las variables son opcionales en el entorno
# local: `pnpm dev` y `pnpm dev:https` dan un valor a las que faltan. Para
# cambiar alguna, copia este archivo como `.env` y edítalo.

# Base de datos. El valor por defecto es el de `docker-compose.yml`.
DATABASE_URL=postgres://gameboard:gameboard@localhost:5432/gameboard
# Conexiones simultáneas a la base de datos.
DATABASE_POOL_MAX=10

# Dónde escucha la API.
HOST=localhost
PORT=3000

# Origen del frontend: el único desde el que el navegador puede usar la API.
FRONTEND_ORIGIN=http://localhost:3001

# La cookie de sesión solo viaja por HTTPS. En el modo HTTP local va en `false`.
# En producción no se puede desactivar.
SESSION_COOKIE_SECURE=false
# Días sin actividad y días en total que dura una sesión.
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90
# Cada cuánto se borran las sesiones y los enlaces de recuperación caducados.
AUTH_CLEANUP_MINUTES=60

# Minutos que vale el enlace para recuperar la contraseña.
PASSWORD_RESET_MINUTES=60
# Correo. Por ahora solo existe el simulado (`outbox`), que guarda cada correo
# como un archivo de texto en una carpeta. No se puede usar en producción.
MAIL_TRANSPORT=outbox
# Carpeta del correo simulado. Por defecto, `apps/backend/var/mail`.
# MAIL_OUTBOX_DIR=

# Certificado para servir la API con HTTPS. Las dos variables o ninguna.
# `pnpm dev:https` las rellena con el certificado que crea `pnpm dev:cert`.
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Partidas simultáneas por jugador, contando las salas en las que espera.
MAX_REALTIME_MATCHES_PER_PLAYER=1
MAX_TURN_BASED_MATCHES_PER_PLAYER=20

# Tiempo sin actividad tras el que una sala en espera se cierra sola, y cada
# cuánto se revisa.
ROOM_IDLE_REALTIME_MINUTES=30
ROOM_IDLE_TURN_BASED_HOURS=168
ROOM_IDLE_CHECK_SECONDS=60

# Cada cuánto se buscan partidas con el reloj vencido. Cubre los
# temporizadores que se pierden cuando el servidor se reinicia.
MATCH_CLOCK_CHECK_SECONDS=10

# Tiempo seguido sin conexión tras el que se pierde por abandono una partida
# en tiempo real (regla 7.26).
MATCH_ABANDON_SECONDS=120

# Cada cuánto anota el servidor que sigue en marcha. Al arrancar, el tiempo
# que estuvo parado no se descuenta de ningún reloj (reglas 7.29 y 8.18).
SERVER_LIVENESS_SECONDS=10

# Canal de tiempo real: tamaño máximo de un mensaje, conexiones por jugador,
# suscripciones por conexión, y cada cuánto se envía un latido y se
# comprueba que la sesión sigue valiendo.
REALTIME_MAX_MESSAGE_BYTES=16384
REALTIME_MAX_CONNECTIONS_PER_PLAYER=5
REALTIME_MAX_SUBSCRIPTIONS_PER_CONNECTION=20
REALTIME_HEARTBEAT_SECONDS=25
REALTIME_SESSION_CHECK_SECONDS=60
# Segundos sin ninguna conexión antes de dar a un jugador por desconectado.
# Evita que recargar la página lo muestre desconectado (ADR-015, decisión V3).
REALTIME_DISCONNECT_GRACE_SECONDS=5

# Registro de actividad: `json` o `text`, y nivel (`error`, `warn`, `log`, `debug`).
LOG_FORMAT=text
LOG_LEVEL=log
