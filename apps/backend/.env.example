# Configuración del backend. Todas las variables son opcionales en el entorno
# local: `pnpm dev` y `pnpm dev:https` dan un valor a las que faltan. Para
# cambiar alguna, copia este archivo como `.env` y edítalo.

# Base de datos. El valor por defecto es el de `docker-compose.yml`.
DATABASE_URL=postgres://gameboard:gameboard@localhost:5432/gameboard
# Conexiones simultáneas a la base de datos.
DATABASE_POOL_MAX=10

# Dónde escucha la API.
HOST=localhost
PORT=3000

# Origen del frontend: el único desde el que el navegador puede usar la API.
FRONTEND_ORIGIN=http://localhost:3001

# La cookie de sesión solo viaja por HTTPS. En el modo HTTP local va en `false`.
# En producción no se puede desactivar.
SESSION_COOKIE_SECURE=false
# Días sin actividad y días en total que dura una sesión.
SESSION_IDLE_DAYS=30
SESSION_ABSOLUTE_DAYS=90

# Certificado para servir la API con HTTPS. Las dos variables o ninguna.
# `pnpm dev:https` las rellena con el certificado que crea `pnpm dev:cert`.
# TLS_CERT_FILE=
# TLS_KEY_FILE=

# Registro de actividad: `json` o `text`, y nivel (`error`, `warn`, `log`, `debug`).
LOG_FORMAT=text
LOG_LEVEL=log
