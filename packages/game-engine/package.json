{
  "name": "@gameboard/game-engine",
  "version": "0.0.0",
  "private": true,
  "description": "Contrato del motor de juego, registro de motores y motores concretos. No depende de nada.",
  "type": "module",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./shared": {
      "types": "./dist/shared.d.ts",
      "default": "./dist/shared.js"
    },
    "./testing": {
      "types": "./dist/testing/index.d.ts",
      "default": "./dist/testing/index.js"
    },
    "./four-in-a-row": {
      "types": "./dist/games/four-in-a-row/types.d.ts",
      "default": "./dist/games/four-in-a-row/types.js"
    },
    "./naval-battle": {
      "types": "./dist/games/naval-battle/types.d.ts",
      "default": "./dist/games/naval-battle/types.js"
    },
    "./dominoes": {
      "types": "./dist/games/dominoes/types.d.ts",
      "default": "./dist/games/dominoes/types.js"
    },
    "./blind-five": {
      "types": "./dist/games/blind-five/types.d.ts",
      "default": "./dist/games/blind-five/types.js"
    },
    "./tides": {
      "types": "./dist/games/tides/types.d.ts",
      "default": "./dist/games/tides/types.js"
    }
  },
  "files": [
    "dist"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "build:watch": "tsc -p tsconfig.build.json --watch --preserveWatchOutput",
    "typecheck": "tsc -p tsconfig.json --noEmit",
    "test": "vitest run"
  },
  "devDependencies": {
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
